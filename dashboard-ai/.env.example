# ===== Cahaya Project — dashboard-ai (contoh konfigurasi) =====
# Salin ke .env lalu isi nilai sesungguhnya. JANGAN commit .env.

# Database
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/cahaya

# Server
PORT=4300

# LLM utama (diutamakan). Contoh: gateway 9Router lokal / OpenAI-compatible lain.
# - LLM_BASE_URL : base URL tanpa "/chat/completions" (mis. http://127.0.0.1:20128/v1)
# - LLM_MODEL    : nama model (mis. cbcn/deepseek-v4.1-flash)
# - LLM_API_KEY  : API key gateway (mis. sk-...)
LLM_BASE_URL=https://api.contoh.ai/v1
LLM_MODEL=nama-model
LLM_API_KEY=isi-rahasia

# LLM fallback (Atria) — dipakai bila env LLM_* di atas kosong.
ATRIA_API_KEY=isi-rahasia
ATRIA_BASE_URL=https://api.contoh.ai/v1
ATRIA_MODEL=nama-model

# Riset (opsional)
APIFY_TOKEN=isi-bila-dipakai

# Vision (OCR slide carousel — agent Sena). Default memakai LLM_* bila kosong.
# SENA_VISION_MODEL     : model multimodal (mis. cbcn/glm-5v-turbo)
# SENA_VISION_BASE_URL  : base URL gateway (mis. http://127.0.0.1:20128/v1)
# SENA_VISION_API_KEY   : API key (fallback ke LLM_API_KEY)
SENA_VISION_MODEL=cbcn/glm-5v-turbo
SENA_VISION_BASE_URL=http://127.0.0.1:20128/v1
SENA_VISION_API_KEY=isi-rahasia

# Bedah carousel (agent Sena) — daftar akun kompetitor dipisah koma.
SENA_TARGET_AKUN=https://www.instagram.com/uzi.philosophy/,https://www.instagram.com/climatecardinals/

# Clone carousel (agent Sena) — identitas brand utk clone kompetitor.
# Catatan: konfigurasi brand disimpan di lib/sena-clone.js (objek BRAND, paling atas).
# LLM untuk clone memakai LLM_* di atas (bukan kunci terpisah).

# Publish ke SocialHub (agent Sena) — jam tayang default dalam WIB (UTC+7).
# Script otomatis mengkonversi ke UTC saat kirim scheduleAt.
SENA_JAM_TAYANG=19:00

# Doea hub (penjadwalan Instagram)
DOEA_BASE_URL=https://hub.doea.net/api
DOEA_ACCESS_KEY=isi-rahasia
DOEA_SECRET_KEY=isi-rahasia

# Dashboard login
DASHBOARD_USER=owner
DASHBOARD_PASS=isi-sandi-kuat

# Sesi
SESSION_SECRET=isi-string-acak-panjang
ZONA_WAKTU=Asia/Jakarta

# Batas token harian (rem tangan)
PLAFON_TOKEN_HARIAN=250000

# Studio (kantor)
STUDIO_ACCESS_TOKEN=isi-rahasia

# WhatsApp (WAHA)
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=isi-api-key-waha
WAHA_SESSION=tophillshape
WA_WA_NOTIF=628xxxxxxxxxx
WA_NOTIF_NOMOR=628xxxxxxxxxx
# Nomor tes untuk laporan harian (nomor owner sendiri). Dipakai sebagai
# tujuan default & pengaman (kirim ke nomor lain wajib konfirmasi).
NOMOR_TES=628xxxxxxxxxx
# Whitelist: hanya nomor ini yang boleh memerintah agent via WhatsApp
# (bisa dipisah koma). Kosongkan = fallback ke WA_NOTIF_NOMOR.
WA_OWNER_NOMOR=628xxxxxxxxxx
# LID owner bila WAHA mengirim pengirim sebagai "<lid>@lid" (bukan "@c.us").
# WA_OWNER_LID=252101779267698
WA_INBOUND_TOKEN=isi-token-webhook-inbound

# Section Percakapan — lokasi log percakapan Owner<->agent
PERCAKAPAN_DIR=/opt/cahayaproject/percakapan

# Email (Resend)
RESEND_API_KEY=re_isi-rahasia
